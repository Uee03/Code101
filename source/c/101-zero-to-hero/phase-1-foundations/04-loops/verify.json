{
  "requires": [
    "gcc"
  ],
  "steps": [
    {
      "name": "build",
      "cmd": "gcc -std=c17 -Wall -Wextra -o app main.c",
      "cwd": "code"
    },
    {
      "name": "run",
      "cmd": "{python} -c \"import os,subprocess,sys;sys.exit(subprocess.call([os.path.abspath('app')]))\"",
      "cwd": "code",
      "stdin": "5\n",
      "expect_stdout": "How many numbers to add (1 to 10)?\nAdded 1, sum is 1\nAdded 2, sum is 3\nAdded 3, sum is 6\nAdded 4, sum is 10\nAdded 5, sum is 15\nCountdown:\n5\n4\n3\n2\n1\nLiftoff!\nThe sum has 2 digit(s)\nOdd numbers up to 5:\n1\n3\n5\nFirst multiple of 3: 3"
    },
    {
      "name": "build-solution",
      "cmd": "gcc -std=c17 -Wall -Wextra -o app main.c",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution",
      "cmd": "{python} -c \"import os,subprocess,sys;sys.exit(subprocess.call([os.path.abspath('app')]))\"",
      "cwd": "exercise/solution",
      "stdin": "3\n",
      "expect_stdout": "Table for which number (1 to 12)?\n3 x 1 = 3\n3 x 2 = 6\n3 x 3 = 9\n3 x 4 = 12\n3 x 5 = 15\n3 x 6 = 18\n3 x 7 = 21\n3 x 8 = 24\n3 x 9 = 27\n3 x 10 = 30"
    }
  ]
}
