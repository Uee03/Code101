{
  "requires": [
    "python",
    "java"
  ],
  "steps": [
    {
      "name": "local Android SDK environment",
      "cwd": "code",
      "cmd": "{python} tools/prepare_sdk.py",
      "expect_contains": [
        "Android SDK configured; local.properties is not shipped."
      ]
    },
    {
      "name": "compile exercise solution as a resource overlay",
      "cwd": "code",
      "cmd": "{python} tools/apply_exercise.py",
      "expect_contains": [
        "Exercise solution installed as English UK resources; both variants build in one APK."
      ]
    },
    {
      "name": "remove committed schema in disposable copy",
      "cwd": "code",
      "cmd": "{python} -c \"import shutil; shutil.rmtree('app/schemas', ignore_errors=True)\""
    },
    {
      "name": "regenerate client from contract",
      "cwd": "code",
      "cmd": "gradlew.bat openApiGenerate --console=plain",
      "timeout": 1800,
      "expect_contains": [
        "BUILD SUCCESSFUL"
      ]
    },
    {
      "name": "assemble debug once",
      "cwd": "code",
      "cmd": "gradlew.bat assembleDebug --console=plain",
      "timeout": 1800,
      "expect_contains": [
        "BUILD SUCCESSFUL"
      ]
    },
    {
      "name": "inspect APK without device",
      "cwd": "code",
      "cmd": "{python} tools/inspect_debug.py",
      "expect_contains": [
        "Debug APK exists; application id, redirect scheme, network config and 10 icons checked."
      ]
    },
    {
      "name": "inspect newly exported Room schema",
      "cwd": "code",
      "cmd": "{python} tools/inspect_schema.py",
      "expect_contains": [
        "Room schema v1 exported: account, comments, outbox, projects, tasks, teams."
      ]
    }
  ],
  "cleanup": [
    {
      "name": "stop wrapper Gradle daemons",
      "cwd": "code",
      "cmd": "gradlew.bat --stop",
      "timeout": 180
    }
  ],
  "skip_lesson_check": [
    "code/app/schemas/com.code101.tasks.data.local.TasksDatabase/1.json",
    "code/app/src/main/kotlin-generated/.openapi-generator/FILES",
    "code/app/src/main/kotlin-generated/.openapi-generator/VERSION",
