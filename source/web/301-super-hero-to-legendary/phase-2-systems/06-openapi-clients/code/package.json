    "node": ">=26.13.1",
    "npm": ">=11.20.0"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
