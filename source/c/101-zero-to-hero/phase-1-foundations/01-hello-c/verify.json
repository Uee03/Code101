{
  "requires": [
    "gcc"
  ],
  "steps": [
    {
      "name": "build",
      "cmd": "gcc -std=c17 -Wall -Wextra -o app main.c",
      "cwd": "code"
    },
    {
      "name": "run",
      "cmd": "{python} -c \"import os,subprocess,sys;sys.exit(subprocess.call([os.path.abspath('app')]))\"",
      "cwd": "code",
      "expect_stdout": "Hello, C!\nMy first program runs."
    },
    {
      "name": "build-solution",
      "cmd": "gcc -std=c17 -Wall -Wextra -o app main.c",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution",
      "cmd": "{python} -c \"import os,subprocess,sys;sys.exit(subprocess.call([os.path.abspath('app')]))\"",
      "cwd": "exercise/solution",
      "expect_stdout": "Recipe: Tea\nIngredients:\n- 1 cup water\n- 1 tea bag\n- 1 spoon sugar\nSteps: boil, steep, sip."
    }
  ]
}
