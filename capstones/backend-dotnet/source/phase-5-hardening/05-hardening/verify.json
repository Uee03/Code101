    "code/requests/empty-team.json",
    "code/requests/new-team.json",
    "code/scripts/call.py",
    "code/scripts/conformance.py",
    "code/scripts/show_token.py",
    "code/src/TasksApi/Common/DbErrors.cs",
    "code/src/TasksApi/Common/ETags.cs",
    "code/src/TasksApi/Common/Optional.cs",
    "code/src/TasksApi/Common/Paging.cs",
    "code/src/TasksApi/Common/ProblemException.cs",
    "code/src/TasksApi/Common/ProblemResponses.cs",
    "code/src/TasksApi/Common/ResponseHeaders.cs",
    "code/src/TasksApi/Contracts/Dtos.cs",
    "code/src/TasksApi/Contracts/MeDto.cs",
    "code/src/TasksApi/Contracts/Requests.cs",
    "code/src/TasksApi/Contracts/TeamDto.cs",
    "code/src/TasksApi/Data/Entities.cs",
    "code/src/TasksApi/Data/Idempotency.cs",
    "code/src/TasksApi/Data/Like.cs",
    "code/src/TasksApi/Data/Projections.cs",
    "code/src/TasksApi/Data/TasksDbContext.cs",
    "code/src/TasksApi/Features/Audit/ListAuditEndpoint.cs",
    "code/src/TasksApi/Features/Comments/CreateCommentEndpoint.cs",
    "code/src/TasksApi/Features/Comments/DeleteCommentEndpoint.cs",
    "code/src/TasksApi/Features/Comments/ListCommentsEndpoint.cs",
    "code/src/TasksApi/Features/Members/ListMembersEndpoint.cs",
    "code/src/TasksApi/Features/Members/PutMemberEndpoint.cs",
    "code/src/TasksApi/Features/Members/RemoveMemberEndpoint.cs",
    "code/src/TasksApi/Features/Platform/HealthEndpoint.cs",
    "code/src/TasksApi/Features/Platform/ListUsersEndpoint.cs",
