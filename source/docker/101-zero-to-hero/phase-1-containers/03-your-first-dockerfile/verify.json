{
  "requires": [
    "docker"
  ],
  "steps": [
    {
      "name": "engine",
      "cwd": "code",
      "cmd": "docker info"
    },
    {
      "name": "build",
      "cwd": "code",
      "cmd": "docker build -t {project}:demo .",
      "timeout": 600
    },
    {
      "name": "start",
      "cwd": "code",
      "cmd": "docker run -d --name code101-verify-03-web -p 127.0.0.1:8080:8000 {project}:demo"
    },
    {
      "name": "probe",
      "cwd": "code",
      "cmd": "curl -fsS http://127.0.0.1:8080/",
      "expect_stdout": "Hello from my image!",
      "retries": 20,
      "retry_delay": 1
    },
    {
      "name": "stop code",
      "cwd": "code",
      "cmd": "docker rm -f code101-verify-03-web"
    },
    {
      "name": "remove code image before solution",
      "cwd": "code",
      "cmd": "docker image rm {project}:demo"
    },
    {
      "name": "solution build",
      "cwd": "exercise/solution",
      "cmd": "docker build -t {project}:demo .",
      "timeout": 600
    },
    {
      "name": "solution start",
      "cwd": "exercise/solution",
      "cmd": "docker run -d --name code101-verify-03-solution -p 127.0.0.1:8080:8000 {project}:demo"
    },
    {
      "name": "solution probe",
      "cwd": "code",
      "cmd": "curl -fsS http://127.0.0.1:8080/",
      "expect_stdout": "Hello from the bakery!",
      "retries": 20,
      "retry_delay": 1
    }
  ],
  "cleanup": [
    {
      "name": "remove code if present",
      "cwd": "code",
      "cmd": "docker rm -f code101-verify-03-web"
    },
    {
      "name": "remove solution",
      "cwd": "code",
      "cmd": "docker rm -f code101-verify-03-solution"
    },
    {
      "name": "remove built image",
      "cwd": "code",
      "cmd": "docker image rm {project}:demo"
    }
  ]
}
