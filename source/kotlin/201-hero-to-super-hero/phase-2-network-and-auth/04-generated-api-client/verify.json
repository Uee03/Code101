{
  "requires": [
    "java"
  ],
  "note": "Copy gradlew, gradlew.bat and gradle-wrapper.jar from capstones/mobile-kotlin/source/phase-1-setup/01-setup/code into code/ before a maintainer run, and make sure ANDROID_HOME points to an SDK with the compileSdk platform. Nothing in this pack has been run yet. The generated client and contract are copies of the capstone's.",
  "steps": [
    {
      "name": "overlay exercise solution",
      "cwd": "code",
      "cmd": "xcopy ..\\exercise\\solution\\app app /E /I /Y"
    },
    {
      "name": "regenerate client from contract",
      "cwd": "code",
      "cmd": "gradlew.bat openApiGenerate --console=plain",
      "timeout": 1800,
      "expect_contains": [
        "BUILD SUCCESSFUL"
      ]
    },
    {
      "name": "assemble debug",
      "cwd": "code",
      "cmd": "gradlew.bat assembleDebug --console=plain",
      "timeout": 1800,
      "expect_contains": [
        "BUILD SUCCESSFUL"
      ]
    }
  ],
  "cleanup": [
    {
      "name": "stop wrapper Gradle daemons",
      "cwd": "code",
      "cmd": "gradlew.bat --stop",
      "timeout": 180
    }
  ],
  "skip_lesson_check": [
    "code/.gitignore",
    "code/gradle.properties",
    "code/settings.gradle.kts",
    "code/gradle/wrapper/gradle-wrapper.properties",
    "code/contract/openapi.yaml",
    "code/app/src/main/kotlin-generated",
    "code/app/src/main/kotlin/com/code101/tasks/TasksApplication.kt",
    "code/app/src/main/kotlin/com/code101/tasks/MainActivity.kt",
    "code/app/src/main/kotlin/com/code101/tasks/ui/theme/Theme.kt",
    "code/app/src/main/kotlin/com/code101/tasks/domain/model/Models.kt",
    "code/app/src/main/kotlin/com/code101/tasks/domain/repository/TasksRepository.kt",
    "code/app/src/main/kotlin/com/code101/tasks/data/repository/FakeTasksRepository.kt",
    "code/app/src/main/kotlin/com/code101/tasks/di/DispatchersModule.kt",
    "code/app/src/main/kotlin/com/code101/tasks/di/RepositoryModule.kt",
    "code/app/src/main/kotlin/com/code101/tasks/ui/common/UiState.kt",
    "code/app/src/main/kotlin/com/code101/tasks/ui/components/Components.kt",
    "code/app/src/main/kotlin/com/code101/tasks/ui/navigation/Routes.kt",
    "code/app/src/main/kotlin/com/code101/tasks/ui/teams/TeamsViewModel.kt",
    "code/app/src/main/kotlin/com/code101/tasks/ui/projects/ProjectsScreen.kt",
    "code/app/src/main/kotlin/com/code101/tasks/ui/projects/ProjectsViewModel.kt",
