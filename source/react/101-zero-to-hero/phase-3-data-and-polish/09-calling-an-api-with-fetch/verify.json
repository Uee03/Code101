{
  "requires": ["node", "npm", "python"],
  "steps": [
    { "name": "install code", "cwd": "code", "cmd": "npm install --no-audit --no-fund", "timeout": 300 },
    { "name": "build code", "cwd": "code", "cmd": "npm run build", "timeout": 300 },
    { "name": "check build output", "cwd": "code", "cmd": "{python} -c \"import os; assert os.path.exists('dist/index.html')\"", "expect_stdout": "" },
    { "name": "serve code", "cwd": "code", "cmd": "npm run dev -- --port 18109", "bg": true, "wait": 3 },
    { "name": "probe api file", "cmd": "{python} -c \"import urllib.request,json; r=urllib.request.urlopen('http://localhost:18109/api/books.json'); d=json.load(r); assert r.status == 200 and len(d) == 4\"", "retries": 10, "retry_delay": 1, "expect_stdout": "" },
    { "name": "overlay solution", "cmd": "{python} -c \"import shutil; ig=shutil.ignore_patterns('node_modules','dist'); shutil.copytree('code','sol',ignore=ig); shutil.copytree('exercise/solution','sol',dirs_exist_ok=True)\"", "expect_stdout": "" },
    { "name": "install solution", "cwd": "sol", "cmd": "npm install --no-audit --no-fund", "timeout": 300 },
    { "name": "build solution", "cwd": "sol", "cmd": "npm run build", "timeout": 300 }
  ],
  "skip_lesson_check": ["code/vite.config.ts", "code/tsconfig.json", "code/tsconfig.app.json", "code/tsconfig.node.json", "code/index.html", "code/.gitignore", "code/src/books.ts", "code/src/App.tsx", "code/src/styles.css", "code/src/components/Header.tsx", "code/src/components/Footer.tsx", "code/src/components/Panel.tsx", "code/src/components/AddBookForm.tsx", "code/src/components/Counter.tsx", "code/src/components/BookCard.tsx", "code/src/components/FilterBar.tsx", "code/src/pages/About.tsx", "code/src/pages/NotFound.tsx", "code/src/pages/Home.tsx", "code/src/pages/BookPage.tsx"]
}
