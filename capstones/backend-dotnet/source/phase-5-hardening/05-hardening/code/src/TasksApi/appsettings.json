{
  "Urls": "http://127.0.0.1:8000",
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5432;Database=tasksteams;Username=tasks_app;Password=tasks_app_local_only;Timeout=5"
  },
  "Auth": {
    "Issuer": "http://localhost:8180/realms/tasksteams",
