{
  "requires": [
    "cmake"
  ],
  "steps": [
    {
      "name": "configure",
      "cmd": "cmake -S . -B build",
      "cwd": "code"
    },
    {
      "name": "build",
      "cmd": "cmake --build build",
      "cwd": "code"
    },
    {
      "name": "run",
      "cmd": "cmake -E env build/out/smartptr",
      "cwd": "code",
      "stdin": "",
      "expect_stdout": "open report\ntitle: report\nfinishing report\nclose report\nreport was handed over\nopen note\ntitle: note\nclose note\nend of main"
    },
    {
      "name": "solution configure",
      "cmd": "cmake -S . -B build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution build",
      "cmd": "cmake --build build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution",
      "cmd": "cmake -E env build/out/smartptr",
      "cwd": "exercise/solution",
      "stdin": "",
      "expect_stdout": "issue 7\nusing ticket 7\nvoid 7"
    }
  ],
  "skip_lesson_check": []
}
