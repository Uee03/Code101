{
  "requires": [
    "java"
  ],
  "note": "Copy gradlew, gradlew.bat and gradle-wrapper.jar from capstones/mobile-kotlin/source/phase-1-setup/01-setup/code into code/ before a maintainer run, and make sure ANDROID_HOME points to an SDK with the compileSdk platform. Nothing in this pack has been run yet. The first build writes app/schemas (Room schema export). Files unchanged since lesson 06 are skipped by the static check.",
  "steps": [
    {
      "name": "assemble debug",
      "cwd": "code",
      "cmd": "gradlew.bat assembleDebug --console=plain",
      "timeout": 1800,
      "expect_contains": [
        "BUILD SUCCESSFUL"
      ]
    }
  ],
  "cleanup": [
