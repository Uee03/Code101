{
  "requires": [
    "node",
    "npm",
    "docker"
  ],
  "steps": [
    {
      "name": "install code",
      "cwd": "code",
      "cmd": "npm install --no-audit --no-fund",
      "timeout": 300
    },
    {
      "name": "typecheck code",
      "cwd": "code",
      "cmd": "npx tsc --noEmit",
      "expect_stdout": ""
    },
    {
      "name": "test code",
      "cwd": "code",
      "cmd": "npx vitest run",
      "timeout": 300,
      "expect_contains": ["4 passed (4)", "21 passed (21)"]
    },
    {
      "name": "build code",
      "cwd": "code",
      "cmd": "npx vite build",
      "timeout": 240
    },
    {
      "name": "check build output",
      "cwd": "code",
      "cmd": "{python} -c \"import glob, os; assert os.path.exists('dist/index.html'); assert len(glob.glob('dist/assets/*.js')) >= 1; assert not glob.glob('dist/assets/*.map')\"",
      "expect_stdout": ""
    },
    {
      "name": "docker build",
      "cwd": "code",
      "cmd": "docker build -t code101-verify-task-board:test .",
      "timeout": 600
    },
    {
      "name": "docker run",
      "cwd": "code",
      "cmd": "docker run -d --rm --name code101-verify-task-board -p 18512:8080 code101-verify-task-board:test"
    },
    {
      "name": "probe headers",
      "cmd": "{python} -c \"import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:18512/'); s=r.read().decode(); assert r.status == 200 and '<title>Task board</title>' in s; assert 'default-src' in r.headers['Content-Security-Policy']; assert r.headers['X-Content-Type-Options'] == 'nosniff'\"",
      "retries": 10,
      "retry_delay": 1,
      "expect_stdout": ""
    },
    {
      "name": "overlay solution",
      "cmd": "{python} -c \"import shutil; ig=shutil.ignore_patterns('node_modules','dist'); shutil.copytree('code','sol',ignore=ig); shutil.copytree('exercise/solution','sol',dirs_exist_ok=True)\"",
      "expect_stdout": ""
    },
    {
      "name": "install solution",
      "cwd": "sol",
      "cmd": "npm install --no-audit --no-fund",
      "timeout": 300
    },
    {
      "name": "test solution",
      "cwd": "sol",
      "cmd": "npx vitest run",
      "timeout": 300,
      "expect_contains": ["5 passed (5)", "25 passed (25)"]
    }
  ],
  "cleanup": [
    {
      "name": "stop container",
      "cmd": "docker rm -f code101-verify-task-board"
    },
    {
      "name": "remove image",
      "cmd": "docker rmi -f code101-verify-task-board:test"
    }
  ]
}
