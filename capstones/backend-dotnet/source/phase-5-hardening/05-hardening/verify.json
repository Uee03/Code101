{
  "requires": [
    "docker",
    "dotnet"
  ],
  "steps": [
    {
      "name": "Docker engine",
      "cwd": "code",
      "cmd": "docker info"
    },
    {
      "name": "build the image and start Postgres, Keycloak and the API",
      "cwd": "code",
      "cmd": "{python} -c \"from pathlib import Path; import subprocess; Path('.env').write_bytes(Path('.env.example').read_bytes()); raise SystemExit(subprocess.call(['docker','compose','-p','{project}','up','-d','--build','--wait']))\"",
      "timeout": 900,
      "retries": 2,
      "retry_delay": 5
    },
    {
      "name": "health through the published port",
      "cwd": "code",
      "cmd": "curl -s http://127.0.0.1:8000/health",
      "retries": 10,
      "retry_delay": 1,
      "expect_stdout": "{\"status\":\"ok\",\"version\":\"1.0.0\",\"database\":\"up\"}"
    },
    {
      "name": "conformance: all 18 checks pass",
      "cwd": "code",
      "cmd": "{python} scripts/conformance.py",
      "timeout": 420,
      "retries": 3,
      "retry_delay": 5,
      "expect_contains": [
        "PASS  health (200, status ok, no token needed)",
        "PASS  me (alice is admin, RateLimit headers present)",
        "PASS  create task with Idempotency-Key (created once, replay returned the same task, other body gave 422)",
        "PASS  401 without token (401 problem details with a Bearer challenge)",
        "PASS  403 for member on admin route (bob (member) gets 403 on the audit log and on creating a team)",
        "PASS  cleanup (team deleted, then 404)",
        "18 passed, 0 failed"
      ]
    },
    {
      "name": "headers on an anonymous request: rate limit and security headers",
      "cwd": "code",
      "cmd": "curl -s -i http://127.0.0.1:8000/v1/me",
      "expect_contains": [
        "HTTP/1.1 401 Unauthorized",
        "RateLimit-Limit: 30",
        "X-Content-Type-Options: nosniff",
        "Content-Security-Policy: default-src 'none'; frame-ancestors 'none'",
        "Cache-Control: no-store",
        "Referrer-Policy: no-referrer",
        "WWW-Authenticate: Bearer realm=\"tasksteams\""
      ]
    },
    {
      "name": "a token that is not a token",
      "cwd": "code",
      "cmd": "{python} scripts/call.py --token abc.def.ghi GET /v1/teams",
      "expect_exit": 1,
      "expect_contains": [
        "HTTP 401 Unauthorized",
        "error=\"invalid_token\"",
        "The access token is invalid or has expired."
      ]
    },
    {
      "name": "make a 1.2 MB request body",
      "cmd": "{python} -c \"import json; open('big.json', 'w').write(json.dumps({'name': 'x' * 1200000}))\"",
      "timeout": 60
    },
    {
      "name": "a body over 1 MB is refused",
      "cwd": "code",
      "cmd": "{python} scripts/call.py --as alice POST /v1/teams --body-file ../big.json",
      "expect_exit": 1,
      "expect_contains": [
        "HTTP 413 Payload Too Large",
        "The request body is larger than the 1 MB limit."
      ]
    },
    {
      "name": "a wrong Host header is refused by the framework",
      "cwd": "code",
      "cmd": "curl -s -i http://127.0.0.1:8000/health -H \"Host: evil.example\"",
      "expect_contains": [
        "HTTP/1.1 400 Bad Request",
        "The request hostname is invalid."
      ]
    },
    {
      "name": "a browser preflight from an allowed origin",
      "cwd": "code",
      "cmd": "curl -s -i -X OPTIONS http://127.0.0.1:8000/v1/teams -H \"Origin: http://localhost:4200\" -H \"Access-Control-Request-Method: GET\"",
      "expect_contains": [
        "HTTP/1.1 204 No Content",
        "Access-Control-Allow-Origin: http://localhost:4200"
      ]
    },
    {
      "name": "the request log is JSON and has no token in it",
      "cwd": "code",
      "cmd": "docker compose -p {project} logs api --no-log-prefix --tail 40",
      "expect_contains": [
        "\"Category\":\"TasksApi.Common.RequestLoggingMiddleware\"",
        "GET /v1/me 401"
      ]
    },
    {
      "name": "exercise solution: copy over the project",
      "cmd": "{python} -c \"import shutil; shutil.copytree('code', '_ex', ignore=shutil.ignore_patterns('bin', 'obj')); shutil.copytree('exercise/solution', '_ex', dirs_exist_ok=True)\"",
      "timeout": 60
    },
    {
      "name": "exercise solution builds",
      "cwd": "_ex",
      "cmd": "dotnet build --nologo",
      "timeout": 300,
      "expect_contains": [
        "0 Error(s)"
      ]
    }
  ],
  "cleanup": [
    {
      "name": "remove temporary containers, network and volume",
      "cwd": "code",
      "cmd": "docker compose -p {project} down -v --remove-orphans",
      "timeout": 120
    },
    {
      "name": "remove the image built for this lab",
      "cmd": "{python} -c \"import subprocess; subprocess.call(['docker', 'image', 'rm', 'code101/tasksteams-backend-dotnet:1.0'])\"",
      "timeout": 120
    },
    {
      "name": "release the build output",
      "cmd": "{python} -c \"import shutil, time; time.sleep(2); [shutil.rmtree(p, ignore_errors=True) for p in ('code/src/TasksApi/bin', 'code/src/TasksApi/obj', '_ex')]\"",
      "timeout": 60
    }
  ],
  "skip_lesson_check": [
    "code/db/schema.sql",
    "code/db/seed.sql",
    "code/docker-compose.yml",
    "code/global.json",
    "code/keycloak/realm-tasksteams.json",
