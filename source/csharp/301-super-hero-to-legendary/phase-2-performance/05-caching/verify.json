        "HybridCache, 2 sequential calls: 1 load(s)",
        "Price in the database: 1200, price served from cache: 1000",
        "After RemoveByTagAsync: price 1200, 2 load(s)",
        "After RemoveAsync: 3 load(s)"
      ]
    }
  ],
  "skip_lesson_check": []
}
