{
  "requires": [
    "gcc"
  ],
  "steps": [
    {
      "name": "build",
      "cmd": "gcc -std=c17 -Wall -Wextra -o app main.c",
      "cwd": "code"
    },
    {
      "name": "run",
      "cmd": "{python} -c \"import os,subprocess,sys;sys.exit(subprocess.call([os.path.abspath('app')]))\"",
      "cwd": "code",
      "expect_stdout": "score is 10\nthrough the pointer: 10\np holds the address of score\nscore after *p = 20: 20\nx=8 y=3\nscore with bonus: 25\ntotal: 10\nsecond value: 2\nnothing points nowhere"
    },
    {
      "name": "build-solution",
      "cmd": "gcc -std=c17 -Wall -Wextra -o app main.c",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution",
      "cmd": "{python} -c \"import os,subprocess,sys;sys.exit(subprocess.call([os.path.abspath('app')]))\"",
      "cwd": "exercise/solution",
      "expect_stdout": "n is 42\nlow 1 high 9"
    }
  ]
}
