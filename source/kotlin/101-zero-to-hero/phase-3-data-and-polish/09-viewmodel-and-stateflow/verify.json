{
  "requires": [
    "java"
  ],
  "note": "Android Studio creates gradlew, gradlew.bat and gradle-wrapper.jar for learners. Before a maintainer run, copy those three files from capstones/mobile-kotlin/source/phase-1-setup/01-setup/code into code/ and make sure ANDROID_HOME points to an SDK with the platform used by compileSdk. Nothing in this pack has been run yet.",
  "steps": [
    {
      "name": "overlay exercise solution",
      "cwd": "code",
      "cmd": "xcopy ..\\exercise\\solution\\app app /E /I /Y"
    },
    {
      "name": "assemble debug",
      "cwd": "code",
      "cmd": "gradlew.bat assembleDebug --console=plain",
      "timeout": 1800,
      "expect_contains": [
        "BUILD SUCCESSFUL"
      ]
    }
  ],
  "cleanup": [
    {
      "name": "stop wrapper Gradle daemons",
      "cwd": "code",
      "cmd": "gradlew.bat --stop",
      "timeout": 180
    }
  ],
  "skip_lesson_check": [
    "code/.gitignore",
    "code/build.gradle.kts",
    "code/gradle.properties",
    "code/settings.gradle.kts",
    "code/gradle/wrapper/gradle-wrapper.properties",
    "code/app/src/main/AndroidManifest.xml",
    "code/app/src/main/res/values/strings.xml",
    "code/app/src/main/kotlin/com/code101/taskstart/MainActivity.kt",
    "code/app/src/main/kotlin/com/code101/taskstart/ui/theme/Theme.kt",
    "code/app/src/main/kotlin/com/code101/taskstart/model/Task.kt",
    "code/app/src/main/kotlin/com/code101/taskstart/ui/AddTaskBar.kt",
    "code/app/src/main/kotlin/com/code101/taskstart/ui/TaskCard.kt",
    "code/app/src/main/kotlin/com/code101/taskstart/ui/DetailScreen.kt",
    "code/app/src/main/res/drawable/ic_plus.xml",
    "code/app/src/main/res/drawable/ic_check.xml",
    "code/app/src/main/res/drawable/ic_trash.xml",
    "code/app/src/main/res/drawable/ic_list.xml",
    "code/LICENSE-ICONS-CC0.txt"
  ]
}
