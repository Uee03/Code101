{
  "requires": ["docker"],
  "steps": [
    {
      "name": "engine",
      "cwd": "code",
      "cmd": "docker info"
    },
    {
      "name": "hardened up",
      "cwd": "code",
      "cmd": "docker compose -p {project} -f docker-compose.hardened.yml up -d --build",
      "timeout": 600
    },
    {
      "name": "hardened probe",
      "cwd": "code",
      "cmd": "curl -fsS http://127.0.0.1:8090/",
      "expect_contains": ["\"var_tmp_writable\": false", "\"tmp_writable\": true", "\"cap_bounding\": \"0000000000000000\"", "\"no_new_privs\": \"1\""],
      "retries": 30,
      "retry_delay": 2
    },
    {
      "name": "seccomp blocks mkdir",
      "cwd": "code",
      "cmd": "docker run --rm --security-opt seccomp=seccomp-no-mkdir.json alpine:3.22 mkdir /tmp/blocked",
      "expect_exit": 1
    }
  ],
  "cleanup": [
    {
      "name": "down hardened",
      "cwd": "code",
      "cmd": "docker compose -p {project} -f docker-compose.hardened.yml down -v --remove-orphans"
    },
    {
      "name": "remove built image",
      "cwd": "code",
      "cmd": "docker image rm code101/hardening-demo:1.0.0"
    }
  ]
}
