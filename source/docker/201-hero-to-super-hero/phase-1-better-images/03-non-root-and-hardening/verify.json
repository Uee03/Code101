{
  "requires": ["docker"],
  "steps": [
    { "name": "engine", "cwd": "code", "cmd": "docker info" },
    { "name": "build", "cwd": "code", "cmd": "docker build -t code101-hardened:201 .", "timeout": 600 },
    { "name": "default user", "cwd": "code", "cmd": "docker run --rm code101-hardened:201 python app.py --once", "expect_stdout": "{\"uid\": 10001, \"gid\": 10001, \"write_app\": false, \"write_data\": true, \"write_tmp\": true}" },
    { "name": "read-only", "cwd": "code", "cmd": "docker run --rm --read-only code101-hardened:201 python app.py --once", "expect_stdout": "{\"uid\": 10001, \"gid\": 10001, \"write_app\": false, \"write_data\": false, \"write_tmp\": false}" },
    { "name": "read-only with tmpfs", "cwd": "code", "cmd": "docker run --rm --read-only --tmpfs /tmp code101-hardened:201 python app.py --once", "expect_stdout": "{\"uid\": 10001, \"gid\": 10001, \"write_app\": false, \"write_data\": false, \"write_tmp\": true}" },
    { "name": "root override", "cwd": "code", "cmd": "docker run --rm --user 0:0 code101-hardened:201 python app.py --once", "expect_stdout": "{\"uid\": 0, \"gid\": 0, \"write_app\": true, \"write_data\": true, \"write_tmp\": true}" },
    { "name": "up", "cwd": "code", "cmd": "docker compose up -d --build", "timeout": 600 },
    { "name": "probe", "cwd": "code", "cmd": "curl -fsS http://127.0.0.1:8080/", "expect_stdout": "{\"uid\": 10001, \"gid\": 10001, \"write_app\": false, \"write_data\": true, \"write_tmp\": true}", "retries": 20, "retry_delay": 1 }
  ],
  "cleanup": [
    { "name": "down", "cwd": "code", "cmd": "docker compose down -v --remove-orphans" },
    { "name": "remove image", "cmd": "docker image rm code101-hardened:201" }
  ],
  "skip_lesson_check": []
}
