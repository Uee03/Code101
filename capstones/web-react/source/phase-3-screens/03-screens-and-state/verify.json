{
  "requires": [
    "node",
    "npm",
    "docker",
    "python"
  ],
  "exclusive": "tasksteams",
  "steps": [
    {
      "name": "docker engine",
      "cwd": "code",
      "cmd": "docker info --format \"{{.ServerVersion}}\""
    },
    {
      "name": "install",
      "cwd": "code",
      "cmd": "npm ci --no-audit --no-fund",
      "timeout": 420
    },
    {
      "name": "contract hash",
      "cwd": "code",
      "cmd": "node scripts/check-contract.mjs",
      "expect_contains": [
        "contract: SHA-256 matches platform; 27 operations"
      ]
    },
    {
      "name": "production build",
      "cwd": "code",
      "cmd": "npm run build",
      "timeout": 420,
      "expect_contains": [
        "vite v8.3.8",
        "modules transformed."
      ]
    },
    {
      "name": "temporary backend stack",
      "cwd": "code",
      "cmd": "docker compose --env-file backend/.env.example -f backend/docker-compose.yml -f backend/docker-compose.override.yml -p {project} up -d --build --wait --wait-timeout 420",
      "timeout": 420
    },
    {
      "name": "one generated client smoke",
      "cwd": "code",
      "cmd": "npm run smoke",
      "timeout": 420,
      "expect_contains": [
        "health: ok",
        "me: alice (admin)",
        "without token: 401",
        "PKCE: S256; login page: 200; user store: memory",
        "expiry event: fired without automaticSilentRenew",
        "teams: 2",
        "tasks: 5; nextCursor: null"
      ]
    },
    {
      "name": "exercise solution",
      "cwd": "exercise/solution",
      "cmd": "node ../../code/node_modules/tsx/dist/cli.mjs run.ts",
      "expect_contains": [
        "exercise: cursor stops at null"
      ]
    }
  ],
  "cleanup": [
    {
      "name": "stop backend stack",
      "cwd": "code",
      "cmd": "docker compose --env-file backend/.env.example -f backend/docker-compose.yml -f backend/docker-compose.override.yml -p {project} down -v --remove-orphans",
      "timeout": 180
    },
    {
      "name": "remove built backend image",
      "cwd": "code",
      "cmd": "docker image rm {project}-api"
    }
  ],
  "skip_lesson_check": [
    "code/package-lock.json",
    "code/src/api/schema.d.ts",
    "code/contract/openapi.yaml",
    "code/backend/.gitignore",
    "code/backend/pyproject.toml",
    "code/backend/app/access.py",
    "code/backend/app/auth.py",
    "code/backend/app/config.py",
    "code/backend/app/db.py",
    "code/backend/app/db_errors.py",
    "code/backend/app/dependencies.py",
    "code/backend/app/errors.py",
    "code/backend/app/http.py",
    "code/backend/app/idempotency.py",
    "code/backend/app/logging_config.py",
    "code/backend/app/main.py",
    "code/backend/app/middleware.py",
    "code/backend/app/pagination.py",
    "code/backend/app/ratelimit.py",
    "code/backend/app/schemas.py",
    "code/backend/app/tokens.py",
    "code/backend/app/__init__.py",
    "code/backend/db/schema.sql",
    "code/backend/db/seed.sql",
    "code/backend/keycloak/realm-tasksteams.json",
    "code/backend/requests/reassign-outsider.json",
    "code/backend/requests/task-cancel.json",
    "code/backend/requests/task-create-other.json",
    "code/backend/requests/task-create.json",
    "code/backend/requests/task-patch.json",
    "code/backend/requests/team-invalid.json",
