{
  "requires": ["python"],
  "steps": [
    {
      "name": "run operators.py",
      "cwd": "code",
      "cmd": "{python} operators.py",
      "expect_stdout": "7 + 2 = 9\n7 - 2 = 5\n7 * 2 = 14\n7 / 2 = 3.5\n7 // 2 = 3\n7 % 2 = 1\n7 ** 2 = 49"
    },
    {
      "name": "tip calculator 80 at 15 percent",
      "cwd": "code",
      "cmd": "{python} tip_calculator.py",
      "stdin": "80\n15\n",
      "expect_contains": ["Tip: 12.00", "Total: 92.00"]
    },
    {
      "name": "solution split_bill 90 / 4",
      "cwd": "exercise/solution",
      "cmd": "{python} split_bill.py",
      "stdin": "90\n4\n",
      "expect_contains": ["Each person pays 22.50"]
    },
    {
      "name": "bad input gives ValueError",
      "cwd": "code",
      "cmd": "{python} tip_calculator.py",
      "stdin": "abc\n15\n",
      "expect_exit": 1
    }
  ]
}
