{
  "requires": [
    "go",
    "curl",
    "docker"
  ],
  "steps": [
    {
      "name": "Docker engine",
      "cwd": "code",
      "cmd": "docker info"
    },
    {
      "name": "create .env from .env.example",
      "cwd": "code",
      "cmd": "{python} -c \"from pathlib import Path; Path('.env').write_bytes(Path('.env.example').read_bytes())\""
    },
    {
      "name": "build the image and start db, keycloak and api",
      "cwd": "code",
      "cmd": "docker compose -p {project} up -d --build --wait",
      "timeout": 900,
      "retries": 2,
      "retry_delay": 5
    },
    {
      "name": "health",
      "cwd": "code",
      "cmd": "curl -s http://127.0.0.1:8000/health",
      "retries": 10,
      "retry_delay": 2,
      "expect_contains": [
        "\"database\":\"up\""
      ]
    },
    {
      "name": "conformance: all 18 checks",
      "cwd": "code",
      "cmd": "{python} scripts/conformance.py",
      "retries": 10,
      "retry_delay": 3,
      "expect_contains": [
        "PASS  me (alice is admin, RateLimit headers present)",
        "PASS  audit log",
        "18 passed, 0 failed"
      ]
    },
    {
      "name": "security headers on every answer",
      "cwd": "code",
      "cmd": "curl -s -i http://127.0.0.1:8000/v1/me",
      "expect_contains": [
        "X-Content-Type-Options: nosniff",
        "Cache-Control: no-store",
        "Ratelimit-Limit: 30"
      ]
    },
    {
      "name": "the container is locked down",
      "cwd": "code",
      "cmd": "docker inspect --format \"readonly={{.HostConfig.ReadonlyRootfs}} caps_dropped={{.HostConfig.CapDrop}}\" {project}-api-1",
      "expect_contains": [
        "readonly=true caps_dropped=[ALL]"
      ]
    },
    {
      "name": "exercise solution",
      "cwd": "exercise/solution",
      "cmd": "go run .",
      "expect_stdout": "t+0 s allowed remaining=2\nt+1 s allowed remaining=1\nt+2 s allowed remaining=0\nt+3 s denied\nt+9 s denied\nt+10s allowed remaining=2\nt+11s allowed remaining=1"
    }
  ],
  "cleanup": [
    {
      "name": "remove the temporary stack",
      "cwd": "code",
      "cmd": "docker compose -p {project} down -v --remove-orphans --rmi local"
    }
  ],
  "skip_lesson_check": [
    "code/.env.example",
    "code/Dockerfile",
    "code/db/schema.sql",
    "code/db/seed.sql",
    "code/docker-compose.yml",
    "code/go.mod",
    "code/go.sum",
    "code/internal/auth/jwks.go",
    "code/internal/auth/jwt.go",
    "code/internal/auth/principal.go",
    "code/internal/http/audit.go",
    "code/internal/http/authz.go",
    "code/internal/http/comments.go",
    "code/internal/http/errors.go",
    "code/internal/http/etag.go",
    "code/internal/http/health.go",
    "code/internal/http/me.go",
    "code/internal/http/members.go",
    "code/internal/http/middleware.go",
    "code/internal/http/optional.go",
    "code/internal/http/projects.go",
    "code/internal/http/request.go",
    "code/internal/http/tasks.go",
    "code/internal/http/teams.go",
    "code/internal/http/users.go",
    "code/internal/http/validate.go",
    "code/internal/problem/problem.go",
    "code/internal/store/audit.go",
    "code/internal/store/comments.go",
    "code/internal/store/errors.go",
    "code/internal/store/idempotency.go",
    "code/internal/store/members.go",
    "code/internal/store/page.go",
    "code/internal/store/projects.go",
    "code/internal/store/registry.go",
    "code/internal/store/store.go",
    "code/internal/store/tasks.go",
    "code/internal/store/teams.go",
    "code/internal/store/users.go",
    "code/keycloak/realm-tasksteams.json",
    "code/requests/comment-create.json",
    "code/requests/if-match-1.txt",
    "code/requests/if-match-2.txt",
    "code/requests/if-match-3.txt",
    "code/requests/if-match-4.txt",
    "code/requests/if-match-5.txt",
    "code/requests/if-match-99.txt",
    "code/requests/if-none-match-1.txt",
    "code/requests/member-put.json",
    "code/requests/project-create.json",
    "code/requests/project-invalid.json",
    "code/requests/reassign.json",
    "code/requests/task-clear.json",
    "code/requests/task-create.json",
