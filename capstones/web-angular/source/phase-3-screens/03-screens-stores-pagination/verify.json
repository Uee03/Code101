{
  "requires": [
    "node",
    "npm",
    "npx",
    "python",
    "docker"
  ],
  "exclusive": "tasksteams",
  "steps": [
    {
      "name": "Docker engine",
      "cwd": "code",
      "cmd": "docker info"
    },
    {
      "name": "install locked dependencies",
      "cwd": "code",
      "cmd": "npm ci --no-audit --no-fund",
      "timeout": 420
    },
    {
      "name": "build once",
      "cwd": "code",
      "cmd": "npm run build",
      "timeout": 420,
      "expect_contains": [
        "Application bundle generation complete.",
        "Generated 27 operations: getHealth, getMe, listTasks"
      ]
    },
    {
      "name": "Node generated-client injector spike",
      "cwd": "code",
      "cmd": "npx tsx scripts/node-spike.ts",
      "expect_contains": [
        "Node HttpClient injector: ready"
      ]
    },
    {
      "name": "copy fake local backend environment",
      "cwd": "code",
      "cmd": "{python} -c \"from pathlib import Path; p=Path('smoke-backend'); (p/'.env').write_bytes((p/'.env.example').read_bytes())\""
    },
    {
      "name": "start temporary platform and Python API",
      "cwd": "code/smoke-backend",
      "cmd": "docker compose -p {project} up -d --build --wait --wait-timeout 400",
      "timeout": 420
    },
    {
      "name": "start Angular dev server",
      "cwd": "code",
      "cmd": "npm start",
      "bg": true,
      "wait": 3
    },
    {
      "name": "probe dev server once ready",
      "cwd": "code",
      "cmd": "node -e \"fetch('http://localhost:4200/').then(r=>{if(r.status!==200)process.exit(1);console.log('Dev server: 200')}).catch(()=>process.exit(1))\"",
      "retries": 30,
      "retry_delay": 2,
      "expect_contains": [
        "Dev server: 200"
      ]
    },
    {
      "name": "one generated-client smoke scenario",
      "cwd": "code",
      "cmd": "npm run smoke",
      "timeout": 420,
      "expect_contains": [
        "health: ok",
        "me: alice (admin)",
        "Anonymous request: 401 Unauthorized",
        "authorization: code_challenge_method=S256; login page: 200",
        "Tokens: memory only; nonce and PKCE_verifier: sessionStorage; ts.hint: non-secret localStorage flag",
        "teams: 2",
        "tasks: 5; nextCursor: null"
      ]
    },
    {
      "name": "exercise starter runs",
      "cwd": "exercise/starter",
      "cmd": "node main.mjs",
      "expect_stdout": "TODO: finish the exercise"
    },
    {
      "name": "exercise solution runs",
      "cwd": "exercise/solution",
      "cmd": "node main.mjs",
      "expect_stdout": "limit=25&cursor=opaque_cursor"
    }
  ],
  "cleanup": [
    {
      "name": "remove temporary platform resources",
      "cwd": "code/smoke-backend",
      "cmd": "docker compose -p {project} down -v --remove-orphans",
      "timeout": 420
    },
    {
      "name": "remove built Python API image",
      "cwd": "code",
      "cmd": "{python} -c \"import subprocess; subprocess.run(['docker','image','rm','{project}-api'],check=True)\"",
      "timeout": 180
    }
  ],
