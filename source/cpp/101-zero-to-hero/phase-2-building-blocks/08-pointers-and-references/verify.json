{
  "requires": [
    "cmake"
  ],
  "steps": [
    {
      "name": "configure",
      "cmd": "cmake -S . -B build",
      "cwd": "code"
    },
    {
      "name": "build",
      "cmd": "cmake --build build",
      "cwd": "code"
    },
    {
      "name": "run",
      "cmd": "cmake -E env build/out/pointers",
      "cwd": "code",
      "stdin": "",
      "expect_stdout": "age after alias = 31: 31\nage after *pointer = 32: 32\npointer now reads: 100\nalias still reads: 32\n7, 9, 0, 11\nno even number in odds"
    },
    {
      "name": "solution configure",
      "cmd": "cmake -S . -B build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution build",
      "cmd": "cmake --build build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution",
      "cmd": "cmake -E env build/out/pointers",
      "cwd": "exercise/solution",
      "stdin": "",
      "expect_stdout": "Cheapest: 3\nNo prices"
    }
  ],
  "skip_lesson_check": []
}
