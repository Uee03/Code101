{
  "requires": [
    "cmake"
  ],
  "steps": [
    {
      "name": "configure",
      "cmd": "cmake -S . -B build",
      "cwd": "code"
    },
    {
      "name": "build",
      "cmd": "cmake --build build",
      "cwd": "code"
    },
    {
      "name": "run",
      "cmd": "cmake -E env build/out/strings",
      "cwd": "code",
      "stdin": "",
      "expect_stdout": "Hello, world has 12 characters\nFirst word: Hello\nItems: 3\n1. bread\n2. milk\n3. eggs\nTotal price: 9\nLast item: eggs\nAfter pop_back: 2 items"
    },
    {
      "name": "solution configure",
      "cmd": "cmake -S . -B build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution build",
      "cmd": "cmake --build build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution",
      "cmd": "cmake -E env build/out/strings",
      "cwd": "exercise/solution",
      "stdin": "",
      "expect_stdout": "Names: Ada, Grace, Alan, Linus\nCount: 4"
    }
  ],
  "skip_lesson_check": []
}
