{
  "requires": [
    "docker",
    "cargo"
  ],
  "exclusive": "tasksteams",
  "steps": [
    {
      "name": "Docker engine",
      "cwd": "code",
      "cmd": "docker info"
    },
    {
      "name": "create .env from .env.example",
      "cwd": "code",
      "cmd": "{python} -c \"from pathlib import Path; Path('.env').write_bytes(Path('.env.example').read_bytes())\""
    },
    {
      "name": "start temporary Postgres and Keycloak",
      "cwd": "code",
      "cmd": "docker compose -p {project} up -d --wait",
      "timeout": 300,
      "retries": 2,
      "retry_delay": 5
    },
    {
      "name": "compile the API",
      "cwd": "code",
      "cmd": "cargo build --locked",
      "timeout": 900
    },
    {
      "name": "start the API",
      "cwd": "code",
      "cmd": "cargo run --locked --quiet",
      "bg": true,
      "wait": 3
    },
    {
      "name": "health probe",
      "cwd": "code",
      "cmd": "{python} scripts/api.py GET /health",
      "retries": 30,
      "retry_delay": 1,
      "expect_contains": [
        "HTTP 200"
      ]
    },
    {
      "name": "a token with a forged payload is refused",
      "cwd": "code",
      "cmd": "{python} scripts/api.py GET /v1/me -H \"Authorization: Bearer eyJhbGciOiAibm9uZSJ9.eyJzdWIiOiAiYjBiMDAwMDAtMDAwMC00MDAwLTgwMDAtMDAwMDAwMDAwMDAyIn0.x\"",
      "expect_exit": 1,
      "expect_contains": [
        "HTTP 401",
        "www-authenticate: Bearer realm=\"tasksteams\", error=\"invalid_token\""
      ]
    },
    {
      "name": "a real token is accepted",
      "cwd": "code",
      "cmd": "{python} scripts/api.py --as alice GET /v1/me",
      "expect_contains": [
        "HTTP 200",
        "\"username\": \"alice\"",
        "\"displayName\": \"Alice Admin\""
      ]
    },
    {
      "name": "a member is not an admin",
      "cwd": "code",
      "cmd": "{python} scripts/api.py --as bob GET /v1/audit-log",
      "expect_exit": 1,
      "expect_contains": [
        "HTTP 403",
        "\"detail\": \"The admin role is required.\""
      ]
    },
    {
      "name": "conformance script (phase 3 passes 17 of 18: only the RateLimit headers are missing)",
      "cwd": "code",
      "cmd": "{python} scripts/conformance.py",
      "expect_exit": 1,
      "expect_contains": [
        "PASS  401 without token (401 problem details with a Bearer challenge)",
        "PASS  403 for member on admin route (bob (member) gets 403 on the audit log and on creating a team)",
        "FAIL  me: header RateLimit-Limit missing or not a number",
        "17 passed, 1 failed"
      ]
    },
    {
      "name": "exercise solution",
      "cwd": "exercise/solution",
      "cmd": "cargo run --quiet",
      "expect_stdout": "true\ntrue\nfalse\nfalse\ntrue"
    }
  ],
  "cleanup": [
    {
      "name": "remove temporary resources",
      "cwd": "code",
      "cmd": "docker compose -p {project} down -v --remove-orphans"
    }
  ],
  "skip_lesson_check": [
    "code/Cargo.lock",
    "code/.gitignore",
    "code/rustfmt.toml",
    "code/docker-compose.yml",
    "code/db/schema.sql",
    "code/db/seed.sql",
    "code/keycloak/realm-tasksteams.json",
    "code/scripts/api.py",
    "code/scripts/conformance.py",
    "code/src/app.rs",
    "code/src/error.rs",
    "code/src/extract.rs",
    "code/src/http.rs",
    "code/src/models.rs",
    "code/src/validation.rs",
    "code/src/handlers/audit.rs",
    "code/src/handlers/comments.rs",
    "code/src/handlers/health.rs",
    "code/src/handlers/me.rs",
    "code/src/handlers/members.rs",
    "code/src/handlers/mod.rs",
    "code/src/handlers/projects.rs",
    "code/src/handlers/tasks.rs",
    "code/src/handlers/teams.rs",
    "code/src/handlers/users.rs",
    "code/src/store/audit.rs",
    "code/src/store/comments.rs",
    "code/src/store/idempotency.rs",
    "code/src/store/mod.rs",
    "code/src/store/page.rs",
    "code/src/store/projects.rs",
    "code/src/store/tasks.rs",
    "code/src/store/teams.rs",
    "code/src/store/users.rs"
  ]
}
