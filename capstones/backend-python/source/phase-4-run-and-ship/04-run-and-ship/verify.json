{
  "requires": [
    "python",
    "docker"
  ],
  "steps": [
    {
      "name": "Docker engine",
      "cwd": "code",
      "cmd": "docker info"
    },
    {
      "name": "create .env, build the image and start Postgres, Keycloak and the API",
      "cwd": "code",
      "cmd": "{python} -c \"from pathlib import Path; import subprocess; Path('.env').write_bytes(Path('.env.example').read_bytes()); raise SystemExit(subprocess.call(['docker','compose','-p','{project}','up','-d','--build','--wait']))\"",
      "timeout": 900,
      "retries": 2,
      "retry_delay": 5
    },
    {
      "name": "health through the published port",
      "cwd": "code",
      "cmd": "curl -s http://127.0.0.1:8000/health",
      "retries": 20,
      "retry_delay": 1,
      "expect_stdout": "{\"status\":\"ok\",\"version\":\"1.0.0\",\"database\":\"up\"}"
    },
    {
      "name": "the process is not root",
      "cwd": "code",
      "cmd": "docker compose -p {project} exec -T api id",
      "expect_stdout": "uid=10001(app) gid=10001(app) groups=10001(app)"
    },
    {
      "name": "the code folder is not writable",
      "cwd": "code",
      "cmd": "docker compose -p {project} exec -T api sh -c \"touch /srv/x 2>&1\"",
      "expect_exit": 1,
      "expect_contains": [
        "touch: cannot touch '/srv/x': Permission denied"
      ]
    },
    {
      "name": "python version in the image",
      "cwd": "code",
      "cmd": "docker compose -p {project} exec -T api python --version",
      "expect_stdout": "Python 3.14.10"
    },
    {
      "name": "conformance: 17 pass, only the RateLimit headers of chapter 05 are missing",
      "cwd": "code",
      "cmd": "{python} scripts/conformance.py",
      "expect_exit": 1,
      "retries": 2,
      "retry_delay": 5,
      "expect_contains": [
        "PASS  health (200, status ok, no token needed)",
        "FAIL  me: header RateLimit-Limit missing or not a number",
        "PASS  create task with Idempotency-Key (created once, replay returned the same task, other body gave 422)",
        "PASS  audit log (task create and update are in the audit trail)",
        "17 passed, 1 failed"
      ]
    },
    {
      "name": "exercise solution",
      "cwd": "exercise/solution",
      "cmd": "{python} check_dockerfile.py",
      "expect_stdout": "PASS pinned base images\nPASS multi-stage build\nPASS runs as a non-root user\nPASS has a health check\n4 of 4 checks passed"
    },
    {
      "name": "exercise starter compiles",
      "cwd": "exercise/starter",
      "cmd": "{python} -m py_compile check_dockerfile.py"
    }
  ],
  "cleanup": [
    {
      "name": "remove temporary resources",
      "cwd": "code",
      "cmd": "docker compose -p {project} down -v --remove-orphans --rmi local"
    },
    {
      "name": "remove the image if it is still there",
      "cwd": "code",
      "cmd": "{python} -c \"import subprocess; subprocess.call(['docker', 'image', 'rm', '-f', '{project}-api'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\""
    }
  ],
  "skip_lesson_check": [
    "code/.gitignore",
    "code/app/__init__.py",
    "code/app/access.py",
    "code/app/auth.py",
    "code/app/config.py",
    "code/app/db.py",
    "code/app/db_errors.py",
    "code/app/dependencies.py",
    "code/app/errors.py",
    "code/app/http.py",
    "code/app/idempotency.py",
    "code/app/logging_config.py",
    "code/app/main.py",
    "code/app/middleware.py",
    "code/app/pagination.py",
    "code/app/repositories/__init__.py",
    "code/app/repositories/audit.py",
    "code/app/repositories/comments.py",
    "code/app/repositories/members.py",
    "code/app/repositories/projects.py",
    "code/app/repositories/sql.py",
    "code/app/repositories/tasks.py",
    "code/app/repositories/teams.py",
    "code/app/repositories/users.py",
    "code/app/routers/__init__.py",
    "code/app/routers/audit.py",
    "code/app/routers/comments.py",
    "code/app/routers/health.py",
    "code/app/routers/me.py",
    "code/app/routers/members.py",
    "code/app/routers/projects.py",
    "code/app/routers/tasks.py",
    "code/app/routers/teams.py",
    "code/app/routers/users.py",
    "code/app/schemas.py",
    "code/app/tokens.py",
    "code/db/schema.sql",
    "code/db/seed.sql",
    "code/docker-compose.yml",
    "code/keycloak/realm-tasksteams.json",
    "code/pyproject.toml",
    "code/requests/reassign-outsider.json",
    "code/requests/task-cancel.json",
    "code/requests/task-create-other.json",
    "code/requests/task-create.json",
    "code/requests/task-patch.json",
    "code/requests/team-invalid.json",
    "code/requests/team-patch.json",
    "code/requests/team-secret.json",
    "code/requests/team-valid.json",
    "code/requirements.txt",
    "code/scripts/call.py",
    "code/scripts/conformance.py",
    "code/scripts/forge_token.py",
    "code/scripts/token_rules.py"
  ],
  "exclusive": "tasksteams"
}
