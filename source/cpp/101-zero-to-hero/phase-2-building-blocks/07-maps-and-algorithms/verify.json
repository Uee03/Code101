{
  "requires": [
    "cmake"
  ],
  "steps": [
    {
      "name": "configure",
      "cmd": "cmake -S . -B build",
      "cwd": "code"
    },
    {
      "name": "build",
      "cmd": "cmake --build build",
      "cwd": "code"
    },
    {
      "name": "run",
      "cmd": "cmake -E env build/out/maps",
      "cwd": "code",
      "stdin": "",
      "expect_stdout": "Word counts:\ncake: 2\njam: 1\ntea: 3\njam appears 1 time(s)\nno scones today\nLowest: 60\nHighest: 95\nTotal: 315\n88 is at position 2"
    },
    {
      "name": "solution configure",
      "cmd": "cmake -S . -B build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution build",
      "cmd": "cmake --build build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution",
      "cmd": "cmake -E env build/out/maps",
      "cwd": "exercise/solution",
      "stdin": "",
      "expect_stdout": "apples: 8\npears: 7\nplums: 2"
    }
  ],
  "skip_lesson_check": []
}
