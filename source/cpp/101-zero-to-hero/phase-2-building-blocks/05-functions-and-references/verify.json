{
  "requires": [
    "cmake"
  ],
  "steps": [
    {
      "name": "configure",
      "cmd": "cmake -S . -B build",
      "cwd": "code"
    },
    {
      "name": "build",
      "cmd": "cmake --build build",
      "cwd": "code"
    },
    {
      "name": "run",
      "cmd": "cmake -E env build/out/functions",
      "cwd": "code",
      "stdin": "",
      "expect_stdout": "Area: 12 Perimeter: 14\nBill with tip: 88\nHello, Ada!"
    },
    {
      "name": "solution configure",
      "cmd": "cmake -S . -B build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution build",
      "cmd": "cmake --build build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution",
      "cmd": "cmake -E env build/out/functions",
      "cwd": "exercise/solution",
      "stdin": "",
      "expect_stdout": "Price after discount: 40"
    }
  ],
  "skip_lesson_check": []
}
