{
  "requires": [
    "dotnet"
  ],
  "steps": [
    {
      "name": "run-memory-only",
      "cwd": "code",
      "cmd": "dotnet run --project . --nologo",
      "timeout": 240,
      "expect_contains": [
        "L2 cache: none (memory only)",
        "IMemoryCache, 3 sequential calls: 1 load(s)",
        "IMemoryCache, 5 parallel callers: ",
