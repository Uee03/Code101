{
  "requires": [
    "cmake"
  ],
  "steps": [
    {
      "name": "configure",
      "cmd": "cmake -S . -B build",
      "cwd": "code"
    },
    {
      "name": "build",
      "cmd": "cmake --build build",
      "cwd": "code"
    },
    {
      "name": "run",
      "cmd": "cmake -E env build/out/hello",
      "cwd": "code",
      "stdin": "",
      "expect_stdout": "Hello, C++!"
    },
    {
      "name": "solution configure",
      "cmd": "cmake -S . -B build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution build",
      "cmd": "cmake --build build",
      "cwd": "exercise/solution"
    },
    {
      "name": "solution",
      "cmd": "cmake -E env build/out/hello",
      "cwd": "exercise/solution",
      "stdin": "",
      "expect_stdout": "=== My card ===\nName: Ada Lovelace\nGoal: write C++\n==============="
    }
  ],
  "skip_lesson_check": []
}
