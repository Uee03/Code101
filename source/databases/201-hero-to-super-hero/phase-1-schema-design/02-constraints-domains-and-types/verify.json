{
  "requires": [
    "docker"
  ],
  "exclusive": "tasksteams",
  "steps": [
    {
      "name": "create local environment",
      "cwd": "code",
      "cmd": "{python} -c \"from pathlib import Path; Path('.env').write_bytes(Path('.env.example').read_bytes())\""
    },
    {
      "name": "start disposable Postgres",
      "cwd": "code",
      "cmd": "docker compose -p {project} up -d --wait",
      "timeout": 180
    },
    {
      "name": "lesson SQL (future execution only)",
      "cwd": "code",
      "cmd": "docker compose -p {project} exec -T db psql -X -q -v ON_ERROR_STOP=1 -U learner -d code101 -f /scripts/lesson.sql",
      "expect_stdout": "order_id|state|quantity\n1|draft|2\nnegative_passes_check|null_check_is_unknown\nf|t\nsku|amount\nN1|5.00\nP1|2.00"
    },
    {
      "name": "exercise solution (future execution only)",
      "cwd": "code",
      "cmd": "docker compose -p {project} exec -T db psql -X -q -v ON_ERROR_STOP=1 -U learner -d code101 -f /exercises/solution/exercise.sql",
      "expect_stdout": "all_quantities_valid\nt"
    }
  ],
  "cleanup": [
    {
      "name": "remove disposable resources",
      "cwd": "code",
      "cmd": "docker compose -p {project} down -v --remove-orphans"
    }
  ]
}
