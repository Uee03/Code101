{
  "requires": [
    "docker",
    "dotnet"
  ],
  "steps": [
    {
      "name": "Docker engine",
      "cwd": "code",
      "cmd": "docker info"
    },
    {
      "name": "start temporary Postgres and Keycloak",
      "cwd": "code",
      "cmd": "{python} -c \"from pathlib import Path; import subprocess; Path('.env').write_bytes(Path('.env.example').read_bytes()); raise SystemExit(subprocess.call(['docker','compose','-p','{project}','up','-d','--wait']))\"",
      "timeout": 420,
      "retries": 2,
      "retry_delay": 5
    },
    {
      "name": "build the project",
      "cwd": "code",
      "cmd": "dotnet build --nologo",
      "timeout": 300,
      "expect_contains": [
        "Build succeeded.",
        "0 Error(s)"
      ]
    },
    {
      "name": "start the API",
      "cwd": "code/src/TasksApi",
      "cmd": "dotnet run --no-build",
      "bg": true,
      "wait": 3
    },
    {
      "name": "health",
      "cwd": "code",
      "cmd": "curl -s http://127.0.0.1:8000/health",
      "retries": 30,
      "retry_delay": 1,
      "expect_stdout": "{\"status\":\"ok\",\"version\":\"1.0.0\",\"database\":\"up\"}"
    },
    {
      "name": "conformance: 17 of 18 checks pass (rate-limit headers arrive in chapter 5)",
      "cwd": "code",
      "cmd": "{python} scripts/conformance.py",
      "timeout": 420,
      "retries": 3,
      "retry_delay": 5,
      "expect_exit": 1,
      "expect_contains": [
        "PASS  token for alice (iss, aud tasks-api, sub, role admin, three scopes)",
        "FAIL  me: header RateLimit-Limit missing or not a number",
        "PASS  401 without token (401 problem details with a Bearer challenge)",
        "PASS  403 for member on admin route (bob (member) gets 403 on the audit log and on creating a team)",
        "PASS  audit log (task create and update are in the audit trail)",
        "17 passed, 1 failed"
      ]
    },
    {
      "name": "no token gives 401 with a Bearer challenge",
      "cwd": "code",
      "cmd": "{python} scripts/call.py GET /v1/me",
      "expect_exit": 1,
      "expect_contains": [
        "HTTP 401 Unauthorized",
        "WWW-Authenticate: Bearer realm=\"tasksteams\"",
        "A bearer access token is required."
      ]
    },
    {
      "name": "bob (member) is refused on the audit log",
      "cwd": "code",
      "cmd": "{python} scripts/call.py --as bob GET /v1/audit-log",
      "expect_exit": 1,
      "expect_contains": [
        "HTTP 403 Forbidden",
        "The 'admin' role is required."
      ]
    },
    {
      "name": "bob reads the claims of his token",
      "cwd": "code",
      "cmd": "{python} scripts/show_token.py bob",
      "expect_contains": [
        "iss: \"http://localhost:8180/realms/tasksteams\"",
        "sub: \"b0b00000-0000-4000-8000-000000000002\"",
        "\"roles\": [\"member\"]"
      ]
    },
    {
      "name": "exercise solution: copy over the project",
      "cmd": "{python} -c \"import shutil; shutil.copytree('code', '_ex', ignore=shutil.ignore_patterns('bin', 'obj')); shutil.copytree('exercise/solution', '_ex', dirs_exist_ok=True)\"",
      "timeout": 60
    },
    {
      "name": "exercise solution builds",
      "cwd": "_ex",
      "cmd": "dotnet build --nologo",
      "timeout": 300,
      "expect_contains": [
        "0 Error(s)"
      ]
    }
  ],
  "cleanup": [
    {
      "name": "remove temporary containers, network and volume",
      "cwd": "code",
      "cmd": "docker compose -p {project} down -v --remove-orphans",
      "timeout": 120
    },
    {
      "name": "release the build output (the API process was just stopped)",
      "cmd": "{python} -c \"import shutil, time; time.sleep(3); [shutil.rmtree(p, ignore_errors=True) for p in ('code/src/TasksApi/bin', 'code/src/TasksApi/obj', '_ex')]\"",
      "timeout": 60
    }
  ],
  "skip_lesson_check": [
    "code/openapi.yaml",
    "code/docker-compose.yml",
    "code/.env.example",
    "code/db/schema.sql",
    "code/db/seed.sql",
    "code/keycloak/realm-tasksteams.json",
    "code/scripts/conformance.py",
    "code/scripts/call.py",
    "code/global.json",
    "code/TasksApi.slnx",
    "code/requests/empty-team.json",
    "code/requests/new-team.json",
    "code/src/TasksApi/Common/ProblemException.cs",
    "code/src/TasksApi/Common/ProblemResponses.cs",
    "code/src/TasksApi/Common/ProblemExceptionHandler.cs",
    "code/src/TasksApi/Common/DbErrors.cs",
    "code/src/TasksApi/Common/ETags.cs",
    "code/src/TasksApi/Common/Paging.cs",
    "code/src/TasksApi/Common/Optional.cs",
    "code/src/TasksApi/Common/ResponseHeaders.cs",
    "code/src/TasksApi/Contracts/TeamDto.cs",
    "code/src/TasksApi/Contracts/MeDto.cs",
    "code/src/TasksApi/Contracts/Dtos.cs",
    "code/src/TasksApi/Contracts/Requests.cs",
    "code/src/TasksApi/Data/Entities.cs",
