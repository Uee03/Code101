{
  "requires": [
    "docker"
  ],
  "steps": [
    {
      "name": "engine",
      "cwd": "code",
      "cmd": "docker info"
    },
    {
      "name": "start",
      "cwd": "code",
      "cmd": "docker run -d --name code101-verify-02-web -p 127.0.0.1:8080:80 nginx:1.28-alpine"
    },
    {
      "name": "probe",
      "cwd": "code",
      "cmd": "curl -fsS http://127.0.0.1:8080/",
      "expect_contains": [
        "Welcome to nginx!"
      ],
      "retries": 20,
      "retry_delay": 1
    },
    {
      "name": "solution",
      "cwd": "exercise/solution",
      "cmd": "docker run -d --name code101-verify-02-exercise -p 127.0.0.1:8081:80 nginx:1.28-alpine"
    },
    {
      "name": "solution probe",
      "cwd": "code",
      "cmd": "curl -fsS http://127.0.0.1:8081/",
      "expect_contains": [
        "Welcome to nginx!"
      ],
      "retries": 20,
      "retry_delay": 1
    }
  ],
  "cleanup": [
    {
      "name": "remove web",
      "cwd": "code",
      "cmd": "docker rm -f code101-verify-02-web"
    },
    {
      "name": "remove exercise",
      "cwd": "code",
      "cmd": "docker rm -f code101-verify-02-exercise"
    }
  ]
}
